# Copy these into the hosting platform's "Secrets" / environment variables. NEVER commit a real secrets.toml.
ANTHROPIC_API_KEY = "sk-ant-..."
OPEN_ROUTER_API_KEY = "sk-or-..."
APP_PASSWORD = "choose-a-long-shared-password"   # optional but recommended: the app spends your API credits
MAX_RUNS_PER_SESSION = "40"                      # optional: cap on processed complaints per browser session
